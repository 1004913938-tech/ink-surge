# ---- required for real captions ----
DEEPGRAM_API_KEY=            # https://console.deepgram.com  (STT, zh/en/id)
ANTHROPIC_API_KEY=           # https://console.anthropic.com (translation)

# ---- LiveKit (defaults work with the bundled livekit.yaml) ----
LIVEKIT_URL=ws://livekit:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secretsecretsecretsecretsecret12

# ---- what browsers use (change to your public hostnames in production) ----
LC_PUBLIC_WEB_URL=http://localhost:5173
LC_PUBLIC_API_URL=http://localhost:8000
LC_CORS_ORIGINS=http://localhost:5173

# ---- app ----
LC_DEV_API_KEY=lc_dev_key    # seeded host account (team plan); paste into the host page
LC_INTERNAL_TOKEN=dev-internal
LC_TARGETS=en,id             # default desktop languages
LC_DOMAIN_HINT=              # e.g. "industrial automation sales meeting"
LC_TRANSLATOR=claude         # claude | fake      (fake = no key needed)
# Speech recognition. For PERSONAL mode (separate 6 speakers in mixed meeting audio,
# auto-detect zh/id/en) use soniox (~$0.12/h). deepgram works with ONE fixed meeting language.
LC_STT=deepgram              # soniox | deepgram | demo  (demo = scripted sentences, no key needed)
SONIOX_API_KEY=              # https://soniox.com  (only for LC_STT=soniox)
LC_SONIOX_URL=               # e.g. wss://stt-rt.jp.soniox.com/transcribe-websocket (region-bound key; no mainland-China region)
LC_LANG_HINTS=zh,id,en       # languages expected when the meeting language is "auto"
LC_DEEPGRAM_AUTO_LANG=id     # Deepgram can't auto-detect zh/id: "auto" meetings are transcribed as this
